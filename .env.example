# Copy to .env (make bootstrap does this). Never commit .env.
CD_ENV=dev
CD_LOG_LEVEL=INFO

CD_FALKORDB_HOST=localhost
CD_FALKORDB_PORT=6380
CD_POSTGRES_DSN=postgresql://causaldeploy:causaldeploy@localhost:5432/causaldeploy
CD_REDIS_URL=redis://localhost:6379/0

# Public URL of this API (OAuth callback + cookies). Prod: https://shoplite-demo.duckdns.org
CD_PUBLIC_BASE_URL=http://localhost:8000
CD_PUBLIC_DOMAIN=shoplite-demo.duckdns.org

# GitHub App (docs/github-app.md). Private key as PEM with literal \n or a quoted multi-line value.
CD_GITHUB_APP_ID=
CD_GITHUB_APP_PRIVATE_KEY=
CD_GITHUB_WEBHOOK_SECRET=
# Web login = the same App's user-to-server OAuth credentials
CD_GITHUB_OAUTH_CLIENT_ID=
CD_GITHUB_OAUTH_CLIENT_SECRET=
# Required in prod (>= 32 random chars): openssl rand -base64 48
# CD_SESSION_SECRET=

# Tracing is exported only when set (e.g. http://localhost:4318)
CD_OTLP_ENDPOINT=

# OpenAI: model is configuration, not code (issue #90)
CD_OPENAI_API_KEY=
CD_OPENAI_MODEL=

# Hosting: DuckDNS dynamic DNS. Secret; only needed by whoever updates the DNS record.
CD_DUCKDNS_TOKEN=
