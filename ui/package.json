{
  "name": "causaldeploy-ui",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "gen:api": "openapi-typescript ../docs/openapi.json -o lib/api/schema.d.ts",
    "dev:mock": "node scripts/dev-mock.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:visual": "node -e \"process.env.VISUAL='1';require('child_process').execSync('npx playwright test e2e/visual.spec.ts',{stdio:'inherit',env:process.env})\"",
    "sync:eval": "node -e \"require('fs').copyFileSync('../docs/results/latest.json','lib/api/fixtures/eval-latest.json')\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.55.0",
    "motion": "^14.2.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "postcss": "^8.5.29",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
